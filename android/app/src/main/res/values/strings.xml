    <!-- Onboarding / DPDP consent (Section 10 screen 1, Section 1.4) -->
    <string name="onboarding_title">Before you begin</string>
    <string name="onboarding_body">Pramāṇa records your device\'s location, sensors, and identity alongside every photo, video, and 360° capture so that it can later be shown the record has not been altered. This is personal data under the Digital Personal Data Protection Act, 2023.</string>
