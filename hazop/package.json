{
  "name": "hazop-master-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Industrial HAZOP, chemical-hazard and regulatory-compliance platform with deterministic risk and threshold engines.",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs && node build.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "psql \"$DATABASE_URL\" -f supabase/migrations/0001_core.sql && psql \"$DATABASE_URL\" -f supabase/migrations/0002_legal.sql"
  },
  "engines": { "node": ">=20" }
}
