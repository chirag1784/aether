# HAZOP MASTER AI — server deployment
# The single-page deployment needs none of this: AI runs on the viewer's own
# Claude account through the platform, so there is no provider key to leak.

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql://hazop:hazop@localhost:5432/hazop
PGVECTOR_DIM=1536

# ------------------------------------------------------------- ai providers
# Keys stay server-side. The browser only ever sees /api/*.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
LOCAL_AI_URL=

# Model routing by task class. light: extraction/classification/formatting.
# medium: node/scenario/recommendation drafting. strong: cross-document
# hazard and legal reasoning.
AI_MODEL_LIGHT=
AI_MODEL_MEDIUM=
AI_MODEL_STRONG=
# A fallback to a lower-capability model for a strong task is recorded on the
# ai_runs row; it is never silent.
AI_FALLBACK_CHAIN=

# ---------------------------------------------------------------- research
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_FETCH_ENABLED=true
CHEMICAL_RESEARCH_ENABLED=true

# ------------------------------------------------------------------- legal
LEGAL_RESEARCH_ENABLED=true
LEGAL_OFFICIAL_ONLY_DEFAULT=true
# Stays false until the register and applicability model are in production use.
LEGAL_UPDATE_CHECK_ENABLED=false

# ----------------------------------------------------------------- storage
STORAGE_BUCKET=hazop-documents
SIGNED_URL_TTL_SECONDS=900

# -------------------------------------------------------------- governance
# Document text must not leave the deployment unless the project allows it.
DEFAULT_CONFIDENTIAL_DOCUMENTS=true
DEFAULT_RESEARCH_ENABLED=false
AUDIT_RETENTION_DAYS=3650
